{
    "name": "afmbe-idle",
    "scripts": {
        "check": "tsc --noEmit --skipLibCheck",
        "scss": "sass --style=compressed --quiet --no-charset styles/%npm_package_name%.scss:styles/%npm_package_name%.css",
        "build": "esbuild src/main.ts --bundle --keep-names --minify --sourcemap --outdir=scripts",
        "dev": "esbuild src/main.ts --bundle --keep-names --watch --sourcemap --outdir=scripts"
    },
    "author": "Idle",
    "homepage": "https://github.com/reonZ/afmbe-idle#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reonZ/afmbe-idle.git"
    },
    "bugs": {
        "url": "https://github.com/reonZ/afmbe-idle/issues"
    },
    "devDependencies": {
        "@7h3laughingman/foundry-types": "^14.363.0",
        "esbuild": "^0.20.1",
        "sass": "^1.97.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "remeda": "^2.58.0"
    }
}
