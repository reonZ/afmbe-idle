<div class="attributes">
    <div class="primary">
        {{#each attributes.primary as |attribute|}}
        <div class="attribute" data-attribute-key="{{attribute.key}}">
            {{attribute.label}}
            <input type="number" value="{{attribute.value}}" disabled />
        </div>
        {{/each}}
    </div>
    <div class="secondary">
        {{#each attributes.secondary as |attribute|}}
        <div class="attribute" data-attribute-key="{{attribute.key}}">
            {{attribute.label}}
            <input
                type="number"
                name="system.{{attribute.key}}.value"
                value="{{attribute.value}}"
                min="0"
                max="{{attribute.max}}"
            />
            {{#unless (eq attribute.max Infinity)}}
            / <input type="number" value="{{attribute.max}}" disabled />
            {{/unless}}
        </div>
        {{/each}}
        <div class="attribute" data-attribute-key="speed">
            {{localize 'afmbe.actor.speed.label'}}
            <input type="number" value="{{attributes.speed.value}}" disabled />
        </div>
    </div>
</div>
