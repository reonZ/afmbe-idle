{{#with attributes}}
<div class="attributes">
    <div class="header">
        {{localize 'afmbe.actor.creature.attributes.primary'}}
    </div>
    <div class="primary">
        {{#each primary as |attribute|}}
        <label class="name">
            {{attribute.label}}
        </label>
        <input type="number" class="value" value="{{attribute.value}}" disabled />
        <a
            data-action="roll-task"
            data-attribute="{{attribute.key}}"
            data-disable="attribute"
            data-tooltip="{{localize 'afmbe.actor.creature.task.roll' type=attribute.label}}"
        >
            <i class="fa-solid fa-dice-d10"></i>
        </a>
        {{/each}}
    </div>
    <div class="header">
        {{localize 'afmbe.actor.creature.attributes.secondary'}}
    </div>
    <div class="secondary">
        {{#each secondary as |attribute|}}
        <label class="name" for="{{rootId}}-{{attribute.key}}">
            {{attribute.label}}
        </label>
        <input
            type="number"
            name="system.{{attribute.key}}.value"
            id="{{rootId}}-{{attribute.key}}"
            class="value"
            value="{{attribute.value}}"
            min="0"
            max="{{attribute.max}}"
        />
        {{#unless (eq attribute.max null)}}
        <div class="separator"></div>
        <input type="number" class="max" value="{{attribute.max}}" disabled />
        {{/unless}}
        {{/each}}
        <div class="speed">
            <div>{{speed.label}}:</div>
            <div>{{speed.stringified}}</div>
        </div>
    </div>
</div>
{{/with}}
