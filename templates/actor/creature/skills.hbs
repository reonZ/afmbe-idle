<div class="skills sidebar">
    <div class="title">
        {{localize 'afmbe.item.skill.title'}}
    </div>
    <div class="list">
        {{#each skills as |skill|}}
        <a class="name" data-action="open-sheet" data-item-id="{{skill.id}}">
            {{#if skill.system.isSpecialty}}
            <i class="fa-regular fa-arrow-turn-down-right"></i>
            {{/if}}
            {{skill.name}}
        </a>
        <a
            data-action="roll-task"
            data-skill="{{skill.id}}"
            data-disable="skill"
            data-tooltip="{{localize 'afmbe.actor.creature.task.roll' type=skill.name}}"
        >
            <input type="text" class="modifier" value="{{skill.system.modifier}}" disabled />
        </a>
        {{/each}}
    </div>
</div>
