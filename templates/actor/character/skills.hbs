<div class="skills sidebar">
    <div class="title">
        {{localize 'afmbe.item.skill.title'}}
        <a data-action="add-item" data-item-type="skill">
            <i class="fa-solid fa-plus"></i>
        </a>
    </div>
    <div class="list">
        {{#each skills as |skill|}}
        <a class="name" data-action="open-item-sheet" data-item-uuid="{{skill.uuid}}">
            {{#if skill.system.isSpecialty}}
            <i class="fa-regular fa-arrow-turn-down-right"></i>
            {{/if}}
            {{skill.name}}
        </a>
        <a
            data-action="roll-task"
            data-select-type="skill"
            data-select-value="{{skill.chainId}}"
            data-disable="skill"
            data-tooltip="{{localize 'afmbe.actor.creature.task.roll.task' name=skill.name}}"
        >
            <input type="text" class="modifier disabled" value="{{skill.system.modifier}}" readonly />
        </a>
        {{/each}}
    </div>
</div>
