<label for="{{rootId}}-label">
    {{localize 'afmbe.effect.label'}}
</label>
<input type="text" id="{{rootId}}-label" name="{{rootName}}.label" value="{{value.label}}" placeholder="{{placeholder}}" />
<label for="{{rootId}}-value">
    {{localize 'afmbe.effect.value'}}
</label>
<input type="text" id="{{rootId}}-value" name="{{rootName}}.value" value="{{value.value}}" placeholder="1" />
<label for="{{rootId}}-affects">
    {{localize 'afmbe.actor.creature.modifier.affects.label'}}
</label>
<select id="{{rootId}}-affects" name="{{rootName}}.affects">
    {{selectOptions data.options selected=value.affects localize=true}}
</select>
