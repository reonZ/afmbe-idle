<label for="{{rootId}}-label">
    {{localize 'afmbe.effect.label'}}
</label>
<input type="text" id="{{rootId}}-label" name="{{rootName}}.label" value="{{value.label}}" placeholder="{{placeholder}}" />
<label for="{{rootId}}-value">
    {{localize 'afmbe.effect.value'}}
</label>
<input type="text" id="{{rootId}}-value" name="{{rootName}}.value" value="{{value.value}}" placeholder="1" />
<label for="{{rootId}}-affects">
    {{localize 'afmbe.actor.creature.modifier.affects.label'}}
</label>
<select id="{{rootId}}-affects" name="{{rootName}}.affects">
    {{selectOptions options.affects selected=value.affects localize=true}}
</select>
<label for="{{rootId}}-targets-attribute">
    {{localize 'afmbe.actor.creature.modifier.targets.attribute'}}
</label>
<select id="{{rootId}}-targets-attribute" name="{{rootName}}.targets.attribute">
    {{selectOptions options.attributes blank="" selected=value.targets.attribute localize=true}}
</select>
<label for="{{rootId}}-active">
    {{localize 'afmbe.actor.creature.modifier.active'}}
</label>
<input type="checkbox" id="{{rootId}}-active" name="{{rootName}}.active" {{checked value.active}} />
