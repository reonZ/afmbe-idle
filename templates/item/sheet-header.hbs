<div class="sheet-header">
    <img src="{{img}}" data-action="editImage" data-edit="img" />
    <input type="text" name="name" value="{{name}}" placeholder="{{name}}" />
    {{#if level}}
    <div class="level">
        <label for="{{rootId}}-sheet-header-level">{{level.label}}</label>
        <input
            type="number"
            id="{{rootId}}-sheet-header-level"
            name="{{level.name}}"
            value="{{level.value}}"
            placeholder="{{level.value}}"
            max="{{level.max}}"
            min="{{level.min}}"
        />
    </div>
    {{/if}}
</div>
