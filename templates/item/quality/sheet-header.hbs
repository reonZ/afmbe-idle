<div class="sheet-header">
    <img src="{{item.img}}" data-action="editImage" data-edit="img" />
    <input type="text" name="name" value="{{item.name}}" placeholder="{{item.name}}" />
    {{#if (gt level.max 1)}}
    <label for="{{rootId}}-sheet-header-level">{{localize 'afmbe.item.skill.level'}}</label>
    <input
        type="number"
        id="{{rootId}}-sheet-header-level"
        name="system.level.value"
        value="{{level.value}}"
        placeholder="{{level.value}}"
        min="1"
        max="{{level.max}}"
    />
    {{/if}}
</div>
