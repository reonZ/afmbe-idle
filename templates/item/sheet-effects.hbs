<div class="sheet-effects tab {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects">
    {{#each effects as |effect|}}
    <fieldset data-effect-id="{{effect.id}}" data-change-index="{{effect.index}}">
        <legend>
            {{localize effect.title}}
            <a data-action="delete-effect" data-tooltip="afmbe.effect.delete">
                <i class="fa-solid fa-trash"></i>
            </a>
        </legend>
        {{> (lookup effect 'template') effect}}
    </fieldset>
    {{/each}}
</div>
