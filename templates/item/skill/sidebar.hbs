<div class="sidebar">
    {{#each parents as |parent|}}
    <div class="title">
        {{localize 'afmbe.item.skill.parent' parent.title}}
    </div>
    <div class="list">
        <a data-action="open-item-sheet" data-item-id="{{parent.skill.chainId}}">
            {{parent.skill.name}}
        </a>
        <input type="number" value="{{parent.skill.system.level.value}}" disabled />
    </div>
    {{/each}}
    <div class="title">
        {{localize 'afmbe.item.skill.specialties.title'}}
        <a data-action="add-specialty" data-tooltip="afmbe.item.skill.specialties.add">
            <i class="fa-solid fa-plus"></i>
        </a>
    </div>
    <div class="list">
        {{#each specialties as |specialty|}}
        <a class="name" data-action="open-item-sheet" data-item-id="{{specialty.chainId}}">
            {{specialty.name}}
        </a>
        <input type="number" value="{{specialty.system.level.value}}" disabled />
        {{/each}}
    </div>
</div>
