<div class="sheet-header">
    <img src="{{img}}" data-action="editImage" data-edit="img" />
    <input type="text" name="name" value="{{name}}" placeholder="{{name}}" />
    {{#if parent}}
    <div class="parent">
        Parent
    </div>
    {{/if}}
    <div class="level">
        <label for="{{rootId}}-level">{{localize 'afmbe.item.skill.level'}}</label>
        <input
            type="number"
            id="{{rootId}}-level"
            name="system.level.value"
            value="{{item.system.level.value}}"
            placeholder="{{item.system.level.value}}"
            min="1"
        />
    </div>
</div>
