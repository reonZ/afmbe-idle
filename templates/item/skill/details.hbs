<div class="details">
    <div class="title">
        {{localize 'afmbe.item.skill.specialties.title'}}
        {{#if isOwned}}
        <a data-action="add-specialty" data-tooltip="afmbe.item.skill.specialties.add">
            <i class="fa-solid fa-plus"></i>
        </a>
        {{/if}}
    </div>
    {{> 'specialties' item}}
</div>

{{#*inline 'specialties'}}
{{#each this.system.specialties as |skill|}}
<div class="specialty" data-item-id="{{skill.chainId}}">
    <a class="name" data-action="open-sheet">
        {{skill.name}}
    </a>
    <input type="number" value="{{skill.system.level.value}}" disabled />
    <a data-action="delete-specialty" data-tooltip="afmbe.item.skill.specialty.delete">
        <i class="fa-solid fa-trash"></i>
    </a>
</div>
{{> 'specialties' skill}}
{{/each}}
{{/inline}}
