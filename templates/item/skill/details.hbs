<div class="details">
    <div class="title">
        {{localize 'afmbe.item.skill.specialties.title'}}
        {{#if isOwned}}
        <a data-action="add-specialty" data-tooltip="afmbe.item.skill.specialties.add">
            <i class="fa-solid fa-plus"></i>
        </a>
        {{/if}}
    </div>
    {{#each specialties as |specialty|}}
    <div class="specialty" data-item-id="{{specialty.id}}">
        <a class="name" data-action="open-sheet" >
            {{specialty.name}}
        </a>
        <input type="number" value="{{specialty.system.level.value}}" disabled />
        <a data-action="delete-specialty" data-tooltip="afmbe.item.skill.specialties.delete">
            <i class="fa-solid fa-trash"></i>
        </a>
    </div>
    {{/each}}
</div>
